{
  "compilerOptions": {
    "rootDir": "./src",
    "target": "es2025", 
    "module": "nodenext",
    "outDir": "dist/mjs/",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "inlineSourceMap": true,
    "strict": true,
    "incremental": true,
    "types": ["node", "mocha"]
  },
  "include": ["src/**/*"]
}
